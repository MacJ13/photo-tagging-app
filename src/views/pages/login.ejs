<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= locals.title || "PHOTO APP ADMIN PANEL" %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7fafc;
      }
      .container {
        max-width: 420px;
        margin: 48px auto;
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }

      .form-field {
        margin-bottom: 10px;
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
      }
      input[type="text"],
      input[type="password"] {
        width: 100%;
        padding: 8px 10px;
        /* margin-bottom: 6px; */
        border: 1px solid #e2e8f0;
        border-radius: 4px;
      }
      button {
        width: 100%;
        padding: 10px;
        background: #2b6cb0;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 600;
      }
      .help {
        margin-top: 12px;
        font-size: 13px;
        color: #718096;
      }
     .field-error {
        color: #c53030;
        font-size: 13px;
        margin: 6px 0 3px 0;
        list-style: circle;
        list-style-position: outside;
      }

    </style>
  </head>
  <body>
    <div class="container">
      <h1>Login</h1>

      <% 
        // Accept validation errors passed either as `errors` (top-level) or as
        // `locals.errors`. Also accept `formData` similarly.


        const errors = locals.fieldErrors || undefined;
      %>

      <% if (typeof errors !== undefined && errors) { %>
      <div style="color: #c53030; margin-bottom: 12px">Error!</div>
      <% } %>

      <form method="POST" action="/login">
        <div class="form-field">
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            autocomplete="username"
            aria-invalid="<%= errors && errors.username ? 'true' : 'false' %>"
            value="<%= locals.formData && locals.formData.username ? locals.formData.username : '' %>"
          />
          <% if (errors && errors.username) { %>
           <ul class="field-error">
              <% errors.username.forEach(errorMessage => { %>
                <li><%= errorMessage %></li>
              <% }) %>
            </ul>
          <% } %>
        </div>

        <div class="form-field">
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            aria-invalid="<%= errors && errors.password ? 'true' : 'false' %>"
          />
          <% if (errors && errors.password) { %>
            <ul class="field-error">
              <% errors.password.forEach(errorMessage => { %>
                <li><%= errorMessage %></li>
              <% }) %>
            </ul>
          <!-- <div class="field-error"><%= errors.password %></div> -->
          <% } %>
        </div>

        <button type="submit">Sign in</button>
      </form>
    </div>
  </body>
</html>
