<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= locals.title || "PHOTO APP ADMIN PANEL" %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7fafc;
      }
      .container {
        max-width: 420px;
        margin: 48px auto;
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
      }
      input[type="text"],
      input[type="password"] {
        width: 100%;
        padding: 8px 10px;
        margin-bottom: 6px;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
      }
      button {
        width: 100%;
        padding: 10px;
        background: #2b6cb0;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 600;
      }
      .help {
        margin-top: 12px;
        font-size: 13px;
        color: #718096;
      }
      .field-error {
        color: #c53030;
        font-size: 13px;
        margin-bottom: 6px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h1>Login</h1>

      <% 
        // Accept validation errors passed either as `errors` (top-level) or as
        // `locals.errors`. Also accept `formData` similarly.


        const errors = locals.fieldErrors || undefined;
      %>

      <% if (typeof errors !== undefined && errors) { %>
      <div style="color: #c53030; margin-bottom: 12px">Error!</div>
      <% } %>

      <form method="POST" action="/login">
        <div>
          <label for="username">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            required
            minlength="3"
            maxlength="100"
            autocomplete="username"
            aria-invalid="<%= errors && errors.username ? 'true' : 'false' %>"
            value="<%= locals.formData && locals.formData.username ? locals.formData.username : '' %>"
          />
          <% if (errors && errors.username) { %>
          <div class="field-error"><%= errors.username %></div>
          <% } %>
        </div>

        <div>
          <label for="password">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            minlength="6"
            autocomplete="current-password"
            aria-invalid="<%= errors && errors.password ? 'true' : 'false' %>"
          />
          <% if (errors && errors.password) { %>
          <div class="field-error"><%= errors.password %></div>
          <% } %>
        </div>

        <button type="submit">Sign in</button>
      </form>
    </div>
  </body>
</html>
