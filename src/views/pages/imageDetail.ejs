    %>
    <script nonce="<%= cspNonce %>">

      let activeObjectId = "";
      let isDragging = false;
      let elementObjectImage = null;

      const imageObjects = <%- JSON.stringify(imageObjectsData) %>;

      // function to set field values in form
      function setFieldValues(objectId, selection) {    
        const numberId = objectId.slice(-1)
            
      
        document.getElementById(`startX${numberId}`).value = selection.startX;
        document.getElementById(`endX${numberId}`).value = selection.endX;
        document.getElementById(`startY${numberId}`).value = selection.startY;
        document.getElementById(`endY${numberId}`).value = selection.endY;
          
        const positionDataDiv = document.getElementById(`positionData${numberId}`); 

        // also show position data in positionDataDiv
        positionDataDiv.innerHTML = `
          <div class="field">
            Position of object:
          </div>
          <div class="position-result">
            <span>Start X: </span>
            <span>${selection.startX}</span>
            </div>
            <div class="position-result">
              <span>End X:</span>
              <span>${selection.endX}</span>
            </div>
            <div class="position-result">
              <span>Start Y:</span>
              <span>${selection.startY}</span>
            </div>
            <div class="position-result">
              <span>End Y:</span>
              <span>${selection.endY}</span>
            </div>
          `;
      }

     


      ///////// CLICK EVENT ON ACTIVE AND CLEAR BUTTONS ///////////
      const objectGroupsDiv =  document.querySelector(".object-groups");
      
      objectGroupsDiv.addEventListener("click", (e) => {
        const objectGroupFieldDivs = objectGroupsDiv.querySelectorAll(".object-group"); 

          objectGroupFieldDivs.forEach(objectDiv => {
            const id =  objectDiv.id
            imageObjects[id].active = false;
            objectDiv.style.borderWidth = "1px";
            objectDiv.querySelector(".object-active").innerText = "Active";
          })

          const objectActiveButton = e.target.closest(".object-active");
          const objectClearButton = e.target.closest(".object-clear");


          // Clear object data button clicked (button clear on object group)
          if(objectClearButton !== null) {
            const fieldObjectEl = objectClearButton.closest(".object-group");
            const numberId = fieldObjectEl.id.slice(-1);

            imageObjects[fieldObjectEl.id].active = false;
            imageObjects[fieldObjectEl.id].ready = false;

            // clear form field values of position
            document.getElementById(`startX${numberId}`).value = "";
            document.getElementById(`endX${numberId}`).value = "";
            document.getElementById(`startY${numberId}`).value = "";
            document.getElementById(`endY${numberId}`).value = "";

            // change position data div to none
            const positionDataDiv = document.getElementById(`positionData${numberId}`); 

            positionDataDiv.innerHTML = `
              <div class="field">
                Position of object: none
              </div>
            `;

            // clear element object from main canva image
            const elementObjectImageId = document.getElementById("element-object-" + fieldObjectEl.id);
            if(elementObjectImageId) {
              elementObjectImageId.remove();
              elementObjectImage = null;
            }

            // reset active object id and isDragging
            isDragging = false
            activeObjectId = ''
            return;
          }

        
          // Activate object button clicked (button active on object group)
          if(objectActiveButton === null) return;
        
          const fieldObjectEl = objectActiveButton.closest(".object-group");

          // If clicked on already active object, disable it
          if(fieldObjectEl.id === activeObjectId) {
            objectActiveButton.innerText = "Active";
            activeObjectId = "";
            return;
          } 
      
          // assign new active object id and set active true
          activeObjectId = fieldObjectEl.id;
          imageObjects[activeObjectId].active = true; 

          objectActiveButton.innerText = "Disable";
          fieldObjectEl.style.borderWidth = "2px";
          fieldObjectEl.style.opacity = "1";
        })
      /////////////////////////////////////////////////////////////


      ///////// CANVAS AND MOUSE EVENTS ///////////

      // load image into canvas
      document.addEventListener("DOMContentLoaded", () => {

        // function to get scaling ratio
        const getScalingRatio = () => {
          const canvasRect = canvas.getBoundingClientRect();
          return originalWidth / canvasRect.width;
        }

        // function to update element object position and size on screen resize
        const updateElementObjectPosition = (objId, screenX, screenY, screenWidth, screenHeight) => {
          // if(!elementObjectImage || !activeObjectId) return;
          // if(!elementObjectImage || !activeObjectId) return;

          const canvasRectangle = canvas.getBoundingClientRect();

          const displayWidth = canvasRectangle.width;
          const displayHeight = canvasRectangle.height;

          const ratioX = displayWidth / originalWidth;
          const ratioY = displayHeight / originalHeight;  



          // const displayLeft = currentSelection.startX * ratioX;
          // const displayTop = currentSelection.startY * ratioY;
          // const displayWidthRect = currentSelection.width * ratioX;
          // const displayHeightRect = currentSelection.height * ratioY;

          // elementObjectImage.style.left = displayLeft + "px";
          // elementObjectImage.style.top = displayTop + "px"; 
          // elementObjectImage.style.width = displayWidthRect + "px";
          // elementObjectImage.style.height = displayHeightRect + "px";

          // convert object into array with id and all image objects positions properties
          const currentImageObjectPositions = Object.entries(imageObjects).map(([key, value]) => {
            return { id: key, selection: value.currentSelection };
          }); 

          // loop through all image objects and update their position and size
          currentImageObjectPositions.forEach(entry => {
            const imageObject = document.getElementById("element-object-" + entry.id);

            if(!imageObject) return;

            const displayLeft = entry.selection.startX * ratioX;
            const displayTop = entry.selection.startY * ratioY;
            const displayWidthRect = entry.selection.width * ratioX;
            const displayHeightRect = entry.selection.height * ratioY;


            imageObject.style.left = displayLeft + "px";
            imageObject.style.top = displayTop + "px"; 
            imageObject.style.width = displayWidthRect + "px";
            imageObject.style.height = displayHeightRect + "px";
          })
        }

        const canvas = document.getElementById("gameCanvas");
        if(!canvas) return;

        const imageURL = canvas.dataset.imageUrl;
        const originalWidth = parseInt(canvas.dataset.originalWidth);
        const originalHeight = parseInt(canvas.dataset.originalHeight);

        canvas.width = originalWidth;
        canvas.height = originalHeight;

        const ctx = canvas.getContext("2d");

        const image = new Image();

        image.crossOrigin = "Anonymous"
        image.src = imageURL;

        image.onload = () => {
          ctx.drawImage(image, 0, 0 , originalWidth, originalHeight);

        }
        image.onerror = () => {
          console.log("Error uploading photo in canvas")
        }

        // variable to store size marking in context of original image size (3543x4961) 
        //  let currentSelection = {
        //     startX: 0,
        //     startY: 0,
        //     width: 0,
        //     height: 0
        //  }   

        // variable to store position beginning in screen pixels  
        let startScreenX = 0;
        let startScreenY = 0; 

        // mouse down event on canvas
        canvas.addEventListener("mousedown", (e) => {
          
          // if no active object id or isDragging is true, return
          const elementObject = document.getElementById("element-object-" + activeObjectId);
          if(elementObject) return;

          if((isDragging) || !activeObjectId) return;
         
          currentSelection = {
            startX: 0,
            startY: 0,
            width: 0,
            height: 0
          }   

          isDragging = true;
          
          startScreenX = e.offsetX;
          startScreenY = e.offsetY;

           // create new element object div and append to main image div
          elementObjectImage = document.createElement("div");
          elementObjectImage.id = "element-object-" + activeObjectId;
          elementObjectImage.classList.add("element-object");
          document.querySelector(".main-image").appendChild(elementObjectImage);

          elementObjectImage.style.left = startScreenX + "px";
          elementObjectImage.style.top = startScreenY + "px";
          elementObjectImage.style.width = "0px";
          elementObjectImage.style.height = "0px";

       });  

        //  mouse move event on canvas 
        canvas.addEventListener("mousemove", (e) => {

          // if no active object id or isDragging is false, return
          const objectImageDiv = document.getElementById("element-object-" + activeObjectId);
          if(!objectImageDiv) return;

          if(!elementObjectImage || !isDragging) return;
        
          const currentScreenX = e.offsetX;
          const currentScreenY = e.offsetY;

          const scalingRatio = getScalingRatio();

          
          let widthScreen = currentScreenX - startScreenX;
          let heightScreen = currentScreenY - startScreenY;
          

          let finalLeft = startScreenX
          let finalTop = startScreenY;

          if(widthScreen < 0) {
            finalLeft = currentScreenX;
            widthScreen = Math.abs(widthScreen);
          }

          if(heightScreen < 0) {
            finalTop = currentScreenY;
            heightScreen = Math.abs(heightScreen);
          }


          objectImageDiv.style.left = finalLeft + "px";
          objectImageDiv.style.top = finalTop + "px";
          objectImageDiv.style.width = widthScreen + "px";
          objectImageDiv.style.height = heightScreen + "px";
        });

        // mouse up event on canvas
        canvas.addEventListener("mouseup", e => {
          // if no active object id or isDragging is false, return
          const objectImageDiv = document.getElementById("element-object-" + activeObjectId);
          if(!objectImageDiv) return;
          if ( !isDragging || !activeObjectId) return;

          // console.log(objectImageDiv);

          // check if field object positions error exist
          // const fieldErrorDiv =  document.getElementById(activeObjectId).querySelector(".field-error");

          // if(fieldErrorDiv) {
          //   fieldErrorDiv.remove();
          // }


          isDragging = false; 

          const canvasRectangle = canvas.getBoundingClientRect();
          const displayWidth = canvasRectangle.width;
          const displayHeight = canvasRectangle.height;

        
          // scalling factor, that was used during drawing on screen
      
          const ratioX = originalWidth / displayWidth;
          const ratioY = originalHeight / displayHeight;

          // final calculation of current selection in original image size (3543x4961)
          const rectLeft = Number(objectImageDiv.style.left.replace("px", ""));
          const rectTop = Number(objectImageDiv.style.top.replace("px", ""));
          const rectWidth = Number(objectImageDiv.style.width.replace("px", ""));
          const rectHeight = Number(objectImageDiv.style.height.replace("px", ""));


          // calculate current selection in original image size (3543x4961)
          const currentObjectElement = imageObjects[activeObjectId];

          imageObjects[activeObjectId].currentSelection.startX = Math.round(rectLeft * ratioX);
          imageObjects[activeObjectId].currentSelection.startY = Math.round(rectTop * ratioY);
          imageObjects[activeObjectId].currentSelection.width = Math.round(rectWidth * ratioX);
          imageObjects[activeObjectId].currentSelection.height = Math.round(rectHeight * ratioY);

          imageObjects[activeObjectId].currentSelection.endX = Math.round((rectLeft + rectWidth) * ratioX);
          imageObjects[activeObjectId].currentSelection.endY = Math.round((rectTop + rectHeight) * ratioY);          
        

          // currentSelection.startX = Math.round(rectLeft * ratioX);
          // currentSelection.startY = Math.round(rectTop * ratioY);
          // currentSelection.width = Math.round(rectWidth * ratioX);
          // currentSelection.height = Math.round(rectHeight * ratioY);

          // currentSelection.endX = Math.round((rectLeft + rectWidth) * ratioX);
          // currentSelection.endY = Math.round((rectTop + rectHeight) * ratioY);          
        

          // mark object as ready
          imageObjects[activeObjectId].ready = true;

          setFieldValues(activeObjectId, imageObjects[activeObjectId].currentSelection);

          // after setting field values, we can also update element object position and size
          // by using function updateElementObjectPosition
          updateElementObjectPosition(activeObjectId);

        });

        // Initialize existing objects if any
        Object.entries(imageObjects).forEach(([key, value]) => {
          if (value.ready) {
            const elementObjectImage = document.createElement("div");
            elementObjectImage.id = "element-object-" + key;
            elementObjectImage.classList.add("element-object");
            document.querySelector(".main-image").appendChild(elementObjectImage);

            // Position the element
            const canvasRect = canvas.getBoundingClientRect();
            const ratioX = canvasRect.width / originalWidth;
            const ratioY = canvasRect.height / originalHeight;

            const displayLeft = value.currentSelection.startX * ratioX;
            const displayTop = value.currentSelection.startY * ratioY;
            const displayWidth = value.currentSelection.width * ratioX;
            const displayHeight = value.currentSelection.height * ratioY;

            elementObjectImage.style.left = displayLeft + "px";
            elementObjectImage.style.top = displayTop + "px";
            elementObjectImage.style.width = displayWidth + "px";
            elementObjectImage.style.height = displayHeight + "px";

            setFieldValues(key, value.currentSelection);
          }
        });

        window.addEventListener('resize', () => {
          // the function to be called when the window is resized
      
          if (elementObjectImage) {
            // calculate and update element object position and size
            updateElementObjectPosition();
          }
        });
      });



    </script>
  </body>
</html>