    <%
    const imageObjectsData = {
      object1: {
        active: false,
        ready: !!(objects && objects[0] && objects[0].startX),
        currentSelection: {
          startX: parseInt((objects && objects[0] && objects[0].startX) || 0, 10),
          startY: parseInt((objects && objects[0] && objects[0].startY) || 0, 10),
          width: (objects && objects[0] && objects[0].endX && objects[0].startX ? parseInt(objects[0].endX, 10) - parseInt(objects[0].startX, 10) : 0),
          height: (objects && objects[0] && objects[0].endY && objects[0].startY ? parseInt(objects[0].endY, 10) - parseInt(objects[0].startY, 10) : 0),
          endX: parseInt((objects && objects[0] && objects[0].endX) || 0, 10),
          endY: parseInt((objects && objects[0] && objects[0].endY) || 0, 10)
        }
      },
      object2: {
        active: false,
        ready: !!(objects && objects[1] && objects[1].startX),
        currentSelection: {
          startX: parseInt((objects && objects[1] && objects[1].startX) || 0, 10),
          startY: parseInt((objects && objects[1] && objects[1].startY) || 0, 10),
          width: (objects && objects[1] && objects[1].endX && objects[1].startX ? parseInt(objects[1].endX, 10) - parseInt(objects[1].startX, 10) : 0),
          height: (objects && objects[1] && objects[1].endY && objects[1].startY ? parseInt(objects[1].endY, 10) - parseInt(objects[1].startY, 10) : 0),
          endX: parseInt((objects && objects[1] && objects[1].endX) || 0, 10),
          endY: parseInt((objects && objects[1] && objects[1].endY) || 0, 10)
        }
      },
