    </div>
    <script>

      const imageObjects = [];
      const activeObject = null
      
      document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById("gameCanvas");

        if(!canvas) return;

        const imageURL = canvas.dataset.imageUrl;
        const originalWidth = parseInt(canvas.dataset.originalWidth);
        const originalHeight = parseInt(canvas.dataset.originalHeight);

        canvas.width = originalWidth;
        canvas.height = originalHeight;

        const ctx = canvas.getContext("2d");

        const image = new Image();

        image.crossOrigin = "Anonymous"
        image.src = imageURL;

        image.onload = () => {
          ctx.drawImage(image, 0, 0 , originalWidth, originalHeight);

        }

        image.onerror = () => {
          console.log("Error uploading photo in canvas")
        }

        // variable to store size marking in context of original image size (3543x4961) 
       let currentSelection = {
        
          startX: 0,
          startY: 0,
          width: 0,
          height: 0
       }   

       // variable to store position beginning in screen pixels  
       let startScreenX = 0;
       let startScreenY = 0; 

       let elementObjectImage = null;
       let isDragging = false;

       const getScalingRatio = () => {
          const canvasRect = canvas.getBoundingClientRect();
          return originalWidth / canvasRect.width;
       }
       const updateElementObjectPosition = (screenX, screenY, screenWidth, screenHeight) => {
          if(!elementObjectImage) return;

          const canvasRectangle = canvas.getBoundingClientRect();

          const displayWidth = canvasRectangle.width;
          const displayHeight = canvasRectangle.height;

          const ratioX = displayWidth / originalWidth;
          const ratioY = displayHeight / originalHeight;  

          const displayLeft = currentSelection.startX * ratioX;
          const displayTop = currentSelection.startY * ratioY;
          const displayWidthRect = currentSelection.width * ratioX;
          const displayHeightRect = currentSelection.height * ratioY;

          elementObjectImage.style.left = displayLeft + "px";
          elementObjectImage.style.top = displayTop + "px"; 
          elementObjectImage.style.width = displayWidthRect + "px";
          elementObjectImage.style.height = displayHeightRect + "px";

       }


       canvas.addEventListener("mousedown", (e) => {
          if(isDragging && elementObjectImage) return;

          isDragging = true;

          

          startScreenX = e.offsetX;
          startScreenY = e.offsetY;

          console.log(e.offsetX, e.offsetY, "Mouse down at (screen pixels)");

          elementObjectImage = document.createElement("div");
          elementObjectImage.classList.add("element-object");
          document.querySelector(".main-image").appendChild(elementObjectImage);

          elementObjectImage.style.left = startScreenX + "px";
          elementObjectImage.style.top = startScreenY + "px";
          elementObjectImage.style.width = "0px";
          elementObjectImage.style.height = "0px";

         
       });  

       canvas.addEventListener("mousemove", (e) => {
          if(!elementObjectImage || !isDragging) return;

          const currentScreenX = e.offsetX;
          const currentScreenY = e.offsetY;

          const scalingRatio = getScalingRatio();

          console.log( "Scaling ratio: ",scalingRatio)
          let widthScreen = currentScreenX - startScreenX;
          console.log("Width screen:", widthScreen);
          let heightScreen = currentScreenY - startScreenY;
          console.log("Height screen:", heightScreen);

          
          let finalLeft = startScreenX

          let finalTop = startScreenY;

          console.log(finalLeft, finalTop, "Initial finalLeft and finalTop");
          if(widthScreen < 0) {
            finalLeft = currentScreenX;
            widthScreen = Math.abs(widthScreen);
          }
          if(heightScreen < 0) {
            finalTop = currentScreenY;
            heightScreen = Math.abs(heightScreen);
          }

          console.log(finalLeft, finalTop, "Initial finalLeft and finalTop");

        elementObjectImage.style.left = finalLeft + "px";
        elementObjectImage.style.top = finalTop + "px";
        elementObjectImage.style.width = widthScreen + "px";
        elementObjectImage.style.height = heightScreen + "px";


        canvas.addEventListener("mouseup", e => {
        if (!elementObjectImage || !isDragging) return;

        isDragging = false; 

        const canvasRectangle = canvas.getBoundingClientRect();
        const displayWidth = canvasRectangle.width;
        const displayHeight = canvasRectangle.height;

        console.log("Canvas display size:", displayWidth, displayHeight);

        // Współczynnik skalowania, który był używany podczas rysowania na ekranie
        const ratioX = originalWidth / displayWidth;
        const ratioY = originalHeight / displayHeight;

        console.log("Scaling ratios - X:", ratioX, "Y:", ratioY); 
        // Ostateczne wymiary i pozycje elementu w pikselach ekranu
        const rectLeft = Number(elementObjectImage.style.left.replace("px", ""));
        const rectTop = Number(elementObjectImage.style.top.replace("px", ""));
        const rectWidth = Number(elementObjectImage.style.width.replace("px", ""));
        const rectHeight = Number(elementObjectImage.style.height.replace("px", ""));

        // **Przeliczenie wymiarów ekranu na wymiary oryginalnego obrazu (3543x4961)**
        currentSelection.startX = Math.round(rectLeft * ratioX);
        currentSelection.startY = Math.round(rectTop * ratioY);
        currentSelection.width = Math.round(rectWidth * ratioX);
        currentSelection.height = Math.round(rectHeight * ratioY);

        console.log("Oryginalne wymiary obiektu:", currentSelection);

        // Po zakończeniu przeciągania, możemy od razu zastosować te same wymiary,
        // używając funkcji updateElementObjectPosition
        updateElementObjectPosition();
    });

    window.addEventListener('resize', () => {
        // Ta funkcja jest wywoływana za każdym razem, gdy zmieniasz rozmiar okna
        if (elementObjectImage) {
            // Przelicz nową pozycję i wymiary
            updateElementObjectPosition();
        }
    });
       });  
 
      
      })


    </script>
  </body>
</html>