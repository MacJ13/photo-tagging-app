<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= locals.title || "PHOTO APP ADMIN PANEL" %></title>
    <style>
      body {
        font-family: Arial, sans-serif;
        background: #f7fafc;
      }
      .container {
        /* max-width: 420px; */
        margin: 48px auto;
        background: #fff;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        display: flex;
        flex-direction: column;
      }
      label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
      }
      input[type="text"],
      input[type="password"] {
        width: 100%;
        padding: 8px 10px;
        margin-bottom: 6px;
        border: 1px solid #e2e8f0;
        border-radius: 4px;
      }
      button {
        width: 100%;
        padding: 10px;
        background: #2b6cb0;
        color: white;
        border: none;
        border-radius: 4px;
        font-weight: 600;
        cursor: pointer;
      }
      a {
                background: #2b6cb0;
        color: white;
        padding: 10px 15px;
        text-decoration: none;  
        border-radius: 4px;
        font-weight: 600;
        display: inline-block;
      }
      .help {
        margin-top: 12px;
        font-size: 13px;
        color: #718096;
      }
      .field-error {
        color: #c53030;
        font-size: 13px;
        margin-bottom: 6px;
      }

      .linkbox {
        margin-top: 12px;
        text-transform: uppercase;
      }

      .heading-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
      }

      .image-new-link {
        margin-bottom: 15px;
      }

      .image-list-heading {
        margin: 15px 0 10px 0;
      }

      .image-list {
        padding: 0;
        margin: 0;
      }

      .image-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 0 20px;
        margin-bottom: 20px;
        
      }

      .image-title {
        font-weight: 600;

      }

      .main-image {
        position: relative;
        max-width: 100%;
      }
.main-image > canvas {
      /* .main-image > img { */
        position: relative;
        width: 100%;
        height: auto;
        display: block;
      }
  .main-image > canvas:hover {
        cursor: crosshair;
      }
  .main-image > canvas:active {
        cursor: grabbing;
      }

  .main-image .element-object {
        box-sizing: border-box;
        position: absolute;
        border: 1px solid #3182ce;
        background: rgba(49, 130, 206, 0.3);
        pointer-events: none;

      }    
.object-groups {
  margin-bottom: 20px;
}

.object-group {
  border: 1px solid #e2e8f0;
  padding: 15px;
  border-radius: 4px;
  margin-bottom: 15px;
  cursor: pointer;
  position: relative;
}

.object-active {

  margin: 0;
  
  left: 0px;
  top: 0px;
  
  color: inherit;

  border-width: 1px;
  border-radius: 4px;
  font-size: 20px;
}

button.object-active {
  background-color: inherit;
  border: 1px solid black;
  color: black;

  width: 150px;
}

button.object-active.object-clear {
  margin-left: 10px;
  border-color: #c53030;
  color: #c53030;
}

.field-group {
  display: flex;
  gap: 20px;

}



.field {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.field-file label {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;

}

.field label {
  margin-bottom: 0;
  min-width: 70px;
}

.field input {
  flex: 1;
}

#object1 {
  background: #f0fff4;
  border-color: #38a169;
}

#object2 {
  background: #ebf8ff;
  border-color: #3182ce;
}

#object3 {
  background: #fff5f5;
  border-color: #e53e3e;

}

input[type="number"] {
  width: 100%;
  padding: 8px 10px;
  border: 1px solid #e2e8f0;
  border-radius: 4px;
}

input[type="file"] {
  /* hidden */
}
input:read-only {
  background: #e2e8f0;
  border: 1px solid #e2e8f0;
  pointer-events: none;
  
}

input::-webkit-outer-spin-button,
input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* Firefox */
input[type=number] {
  -moz-appearance: textfield;
}


    </style>
  </head>

