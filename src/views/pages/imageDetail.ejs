       <div class="main-image">
          <!-- <img src="<%= mainImage.url %>" alt="<%= mainImage.title %>" /> -->
           <canvas id="gameCanvas"
            data-image-url="<%= mainImage.url %>"
            data-original-width="<%= mainImage.width %>"
            data-original-height="<%= mainImage.height %>"
           >
              
           </canvas>
